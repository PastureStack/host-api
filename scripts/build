#!/bin/bash
set -euo pipefail
set -x

cd "$(dirname "$0")/.."

if [ -f ./build/bootstrap.envs ];then
    . ./build/bootstrap.envs
fi

BUILD_VERSION=${VERSION_OVERRIDE:-0.38.4}
BUILD_VERSION=${BUILD_VERSION#v}
if [[ ! "$BUILD_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo 'VERSION_OVERRIDE must use MAJOR.MINOR.PATCH with no suffix' >&2
    exit 1
fi

mkdir -p bin
CGO_ENABLED=0 go build -mod=vendor -trimpath -buildvcs=true -tags "netgo osusergo" \
    -ldflags "-s -w -X main.version=${BUILD_VERSION}" -o bin/host-api
