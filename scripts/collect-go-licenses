#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
output=$(realpath -m "${1:?output directory is required}")
case "$output" in
    "$repo_root"|"$repo_root/"|/|"")
        echo 'refusing unsafe license output directory' >&2
        exit 1
        ;;
    "$repo_root"/*) ;;
    *)
        echo 'license output directory must stay inside the repository' >&2
        exit 1
        ;;
esac

rm -rf -- "$output"
mkdir -p "$output/modules"
: > "$output/MODULES.tsv"

missing=0
while read -r marker module_path module_version remainder; do
    [ "$marker" = '#' ] || continue
    case "$module_version" in
        v*|[0-9]*) ;;
        *) continue ;;
    esac
    module_dir="$repo_root/vendor/$module_path"
    safe_name=$(printf '%s@%s' "$module_path" "$module_version" | sed 's#[^A-Za-z0-9._@+-]#_#g')
    destination="$output/modules/$safe_name"
    found=0
    if [ ! -d "$module_dir" ]; then
        printf 'missing vendored module directory\t%s\t%s\n' "$module_path" "$module_version" >&2
        missing=$((missing + 1))
        continue
    fi
    if [ -d "$module_dir" ]; then
        while IFS= read -r -d '' legal_file; do
            relative=${legal_file#"$module_dir/"}
            install -D -m 0644 "$legal_file" "$destination/$relative"
            found=$((found + 1))
        done < <(find "$module_dir" -maxdepth 2 -type f \
            \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) \
            -print0 | LC_ALL=C sort -z)
    fi
    if [ "$found" -eq 0 ]; then
        printf 'missing license\t%s\t%s\n' "$module_path" "$module_version" >&2
        missing=$((missing + 1))
        continue
    fi
    printf '%s\t%s\t%s\t%d\n' "$module_path" "$module_version" "$safe_name" "$found" \
        >> "$output/MODULES.tsv"
done < <(
    awk '
        function emit_module() {
            if (module_path != "" && package_count > 0) {
                print "#", module_path, module_version
            }
        }
        $1 == "#" {
            emit_module()
            module_path = $2
            module_version = $3
            package_count = 0
            next
        }
        $1 == "##" { next }
        NF > 0 { package_count++ }
        END { emit_module() }
    ' "$repo_root/vendor/modules.txt"
)

if [ "$missing" -ne 0 ]; then
    echo "GO_MODULE_LICENSES_MISSING count=$missing" >&2
    exit 1
fi

(
    cd "$output"
    find modules -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum
) > "$output/SHA256SUMS"
test -s "$output/MODULES.tsv"
test -s "$output/SHA256SUMS"
